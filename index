            if(!val) return "";
            let cleanVal = String(val).trim().toUpperCase();
            if(cleanVal === "LIBUR") return "val-libur";
            
            let num = parseInt(cleanVal);
            if(!isNaN(num) && num >= 1 && num <= 12) {
                return "val-" + num;

        async function salinDataKeTahunBerikutnya() {
            let tahunDepan = tahunAktif + 1;
            
            if (!confirm(`Apakah Anda yakin ingin membuat matriks iuran baru untuk Tahun ${tahunDepan} berdasarkan daftar warga tahun ${tahunAktif}?`)) {
                return;

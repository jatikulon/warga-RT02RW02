                let totalSosial = { jan: 0, feb: 0, mar: 0, apr: 0, mei: 0, jun: 0, jul: 0, agu: 0, sep: 0, okt: 0, nov: 0, des: 0 };

                if (dataWarga.length === 0) {
                    matriksBody.innerHTML = `<tr><td colspan="16" class="text-center" style="padding: 20px; color: #94a3b8;">Belum ada data warga terdaftar di Tahun ${tahunAktif}. Gunakan tombol 'Buat Master Data Tahun Berikutnya' atau Import Excel.</td></tr>`;
                } else {
                    dataWarga.forEach((w, wIdx) => {
                        let nilaiJenis = parseInt(w.jenis) || 10;
                        let bulanCols = '';

                        listBulan.forEach(bln => {
                            let val = w[bln] || "";
                            let colorClass = getColorClassForValue(val);

                            if(val !== "" && String(val).toUpperCase() !== "LIBUR") {
                                let targetBulanKe = parseInt(val);
                                if(!isNaN(targetBulanKe) && targetBulanKe >= 1 && targetBulanKe <= 12) {
                                    let namaBulanTarget = listBulan[targetBulanKe - 1];
                                    if (nilaiJenis === 10) {
                                        total17an[namaBulanTarget] += 5000;
                                        totalSosial[namaBulanTarget] += 5000;
                                    } else if (nilaiJenis === 5) {
                                        totalSosial[namaBulanTarget] += 5000;
                                    } else if (nilaiJenis === 60) {
                                        total17an[namaBulanTarget] += 30000;
                                        totalSosial[namaBulanTarget] += 30000;
                                    }
                                }
                            }
                            
                            bulanCols += `
                                <td class="text-center">
                                    <input type="text" 
                                           class="matrix-input ${colorClass}" 
                                           value="${val}" 
                                           onchange="updateMatriksIuran(${wIdx}, '${bln}', this.value)" />
                                </td>`;
                        });

                        matriksBody.innerHTML += `
                            <tr>
                                <td>${w.no}</td>
                                <td><span style="font-weight:600">${w.nama}</span></td>
                                <td>
                                    <select class="select-jenis" onchange="updateJenisWarga(${wIdx}, this.value)" style="color: ${nilaiJenis===60?'#991b1b':(nilaiJenis===10?'#1e40af':'#92400e')}">
                                        <option value="10" ${nilaiJenis === 10 ? 'selected' : ''}>10</option>
                                        <option value="5" ${nilaiJenis === 5 ? 'selected' : ''}>5</option>
                                        <option value="60" ${nilaiJenis === 60 ? 'selected' : ''}>60</option>
                                    </select>
                                </td>
                                ${bulanCols}
                                <td class="text-center" style="white-space:nowrap;">
                                    <button class="btn-action btn-edit" onclick="editNamaWarga(${wIdx})"><i data-lucide="edit-2" style="width:12px;height:12px;"></i></button>
                                    <button class="btn-action btn-delete" onclick="hapusWarga(${wIdx})"><i data-lucide="trash-2" style="width:12px;height:12px;"></i></button>
                                </td>
                            </tr>
                        `;
                    });
                }

                listBulan.forEach(b => {
                    document.getElementById(`17-${b}`).innerText = formatRupiah(total17an[b]);
                    document.getElementById(`soc-${b}`).innerText = formatRupiah(totalSosial[b]);
                });
            }

            if(window.lucide) lucide.createIcons();
        }
   </script>

</body>
</html>

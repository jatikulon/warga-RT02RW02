            const sidebar = document.getElementById('app-sidebar');
            const toggleBtn = document.getElementById('toggle-btn');
            sidebar.classList.toggle('active');
            
            if (sidebar.classList.contains('active')) {
                toggleBtn.classList.add('hide');
